# gatsby-plugin-sass declares a legacy `node-sass@^4.9.0` peer dependency, but this
# project uses Dart Sass (`sass` + `sass-loader@10`, which prefers dart-sass). With
# npm 7+ auto-installing peers, node-sass gets pulled in and tries to compile a native
# binary that has no prebuilt for Node 16+ (ABI 93+), breaking installs without Python.
# legacy-peer-deps skips that phantom peer so installs stay pure-JS on any Node version
# (matches Netlify's Node 16 build and speeds it up).
legacy-peer-deps=true
